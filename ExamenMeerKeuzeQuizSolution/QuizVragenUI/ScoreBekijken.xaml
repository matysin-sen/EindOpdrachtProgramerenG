        <Window x:Class="QuizVragenUI.ScoreBekijken"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Mijn Scores" Height="450" Width="600">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Mijn Scores" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <DataGrid Grid.Row="1" x:Name="dgScores" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  AlternatingRowBackground="LightGray">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Test Nr" Binding="{Binding IDGemaakteTest}" Width="80"/>
                        <DataGridTextColumn Header="Datum" Binding="{Binding DatumGemaakt, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                        <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Window>


