<Window x:Class="QuizVragenUI.OnderwerpenToevoegen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuizVragenUI"
        mc:Ignorable="d"
        Title="OnderwerpenToevoegen" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions >
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,-3,0">
            <Button x:Name="btnFile" Click="btnFile_Click">Voeg bestand toe</Button>
            <TextBlock HorizontalAlignment="Center" FontSize="12" x:Name="filePathTxt">FilePath</TextBlock>
            <RadioButton x:Name="rbtnTxtAchter" Content="Correctie achter de vraag" GroupName="ReaderType" IsChecked="False"/>
            <RadioButton x:Name="rbtnTxtOnder" Content="Correctie hellemaal vanonder in het document" GroupName="ReaderType" IsChecked="True"/>
            <TextBlock>Welk Onderwerp is het?</TextBlock>
            <ComboBox  FontSize="20" x:Name="cmbBoxOnderwerp" Width="200" SelectionChanged="cmbBoxOnderwerp_SelectionChanged"/>

            <Button x:Name="btnImporteerQuiz" Click="btnStartQuiz_Click">importeer Quiz</Button>
            
            </StackPanel>
    </Grid>
</Window>
